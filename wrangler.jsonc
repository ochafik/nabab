{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nabab",
  "account_id": "9a1d3b00717ed7acc339f1948ff9a9be",
  "main": "src/mcp/worker.ts",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  // Static assets are served first (the web viewer at / and its files);
  // anything that does not match an asset (/mcp, /help) hits the Worker.
  "assets": {
    "directory": "./dist/viewer",
    // Also exposed to the Worker / Durable Objects as env.ASSETS so the MCP
    // server can read the example networks (/examples/*, /bench/models/*)
    // without inlining ~15 MB of models into the script.
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "NB", "class_name": "NababMcpServerDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NababMcpServerDO"] }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": false }
  ]
}
