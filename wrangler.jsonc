{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nabab",
  "main": "src/mcp/worker.ts",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "NB", "class_name": "NababMcpServerDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NababMcpServerDO"] }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.xmlbif"], "fallthrough": false }
  ]
}
